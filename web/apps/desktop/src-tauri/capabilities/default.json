{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: native SQLite, file dialogs, app-data files, opener. API keys and LLM traffic go through the custom commands (secret_*, llm_fetch), which need no plugin permission.",
  "windows": ["main"],
  "permissions": [
    "core:default",

    "sql:default",
    "sql:allow-execute",

    "dialog:default",

    "fs:default",
    "fs:read-files",
    "fs:write-files",
    "fs:read-dirs",
    "fs:read-meta",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-appconfig-read-recursive",
    "fs:allow-appconfig-write-recursive",

    "opener:default"
  ]
}
