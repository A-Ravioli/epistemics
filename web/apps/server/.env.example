# Anthropic key used for every proxied request. Never ships to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Comma-separated static app tokens; clients send `Authorization: Bearer <token>`.
# Unset: anonymous access, one shared daily budget.
#APP_TOKENS=tok1,tok2

# Per-token daily budget in USD (UTC day). Default 5.
DAILY_BUDGET_USD=5

# Optional. Persist the ledger so restarts do not reset budgets.
#LEDGER_PATH=./data/ledger.json

# Optional. Serve apps/web/dist from / (build it first: pnpm --filter @epistemics/web build).
#SERVE_WEB=1
#WEB_DIST=/absolute/path/to/apps/web/dist

# Optional overrides.
#PORT=8787
#ANTHROPIC_BASE_URL=https://api.anthropic.com
